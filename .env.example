# Copy to .env (never commit .env). All values are read ONLY by apps/api.

# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Local development sign-in (refused in production and on non-loopback HOST).
AUTH_PROVIDER=dev
AUTH_DEV_USERS=learner
# Optional shared passcode and HMAC secret (at least 32 characters); keep real values in .env only.
AUTH_DEV_PASSWORD=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_MS=28800000
AUTH_LOGIN_RATE_MAX=10
# Optional key (at least 32 characters) for the L64 audit chains; if empty, one is generated into .data/secrets.
AUDIT_HMAC_KEY=

# Production / containers (L72, docs/DEPLOYMENT-CONFIG.md). NODE_ENV=production requires AUTH_PROVIDER=password,
# AUTH_USERS, AUTH_SESSION_SECRET, AUDIT_HMAC_KEY and an absolute MLP_DATA_DIR; the API exits with code 78 otherwise.
# Every secret X may instead come from a mounted file: X_FILE=/run/secrets/x (set one form, not both), e.g.
# AUTH_SESSION_SECRET_FILE=/run/secrets/auth_session_secret
# Password login users: comma-separated scrypt entries from "npm run auth:hash-user -- <name>".
AUTH_USERS=
# Data directory for every durable store (a persistent volume in containers). Default: <repo>/.data
# MLP_DATA_DIR=/data
# Set when a TLS-terminating proxy sits in front: false | true | loopback | hop count 1-5
TRUST_PROXY=false
# One JSON access-log line per request (request id, method, path without query, status, duration)
LOG_REQUESTS=true

# offline = deterministic mock models, zero cost (default, used by tests)
# live    = real providers allowed when an API key below is set. Live calls cost money.
MASTRA_MODE=offline

# Optional provider keys for live mode. These are API keys from the provider console,
# not ChatGPT/Claude.ai subscriptions (subscriptions do not include API access).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# (GOOGLE_GENERATIVE_AI_API_KEY is also accepted)

# Browser-visible variables MUST start with VITE_PUBLIC_ and must never contain secrets.
# VITE_PUBLIC_EXAMPLE=

# Run limits
MAX_CONCURRENT_RUNS=4
RUN_MAX_TIMEOUT_MS=120000
SSE_DISCONNECT_GRACE_MS=5000
APPROVAL_TIMEOUT_MS=300000
MAX_PENDING_APPROVALS=20
SSE_HEARTBEAT_MS=15000

# Models offered for live runs (comma separated "provider/model" ids, validated against the installed Mastra registry)
# LIVE_MODELS=openai/gpt-5-mini,openai/gpt-4o-mini,anthropic/claude-haiku-4-5,google/gemini-2.5-flash

# L73: deployed staging origin (https) probed by lab-73 live mode, e.g. https://<app>.<region>.azurecontainerapps.io
# STAGING_URL=

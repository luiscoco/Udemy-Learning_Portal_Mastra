# Copy to .env (never commit .env). All values are read ONLY by apps/api.

# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# offline = deterministic mock models, zero cost (default, used by tests)
# live    = real providers allowed when an API key below is set. Live calls cost money.
MASTRA_MODE=offline

# Optional provider keys for live mode. These are API keys from the provider console,
# not ChatGPT/Claude.ai subscriptions (subscriptions do not include API access).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# (GOOGLE_GENERATIVE_AI_API_KEY is also accepted)

# Browser-visible variables MUST start with VITE_PUBLIC_ and must never contain secrets.
# VITE_PUBLIC_EXAMPLE=

# Run limits
MAX_CONCURRENT_RUNS=4
RUN_MAX_TIMEOUT_MS=120000
SSE_DISCONNECT_GRACE_MS=5000
SSE_HEARTBEAT_MS=15000

# Models offered for live runs (comma separated "provider/model" ids, validated against the installed Mastra registry)
# LIVE_MODELS=openai/gpt-5-mini,openai/gpt-4o-mini,anthropic/claude-haiku-4-5,google/gemini-2.5-flash
